{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sage HR Documents Timesheets API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Timesheets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Clock in & out employees on specific days",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://subdomain.sage.hr/api/timesheets/clock-in",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-Auth-Token",
              "value": "{{X-Auth-Token}}",
              "placement": "header"
            }
          },
          "docs": "Employees will be only clocked in & out if API time clocking is enabled for Timesheet group"
        }
      ]
    }
  ],
  "bundled": true
}